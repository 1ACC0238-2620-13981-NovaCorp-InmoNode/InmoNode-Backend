# Copy this file to .env and set your local values. .env is not committed.
# Any variable left out falls back to the defaults in application-dev.properties.
DATABASE_URL=localhost
DATABASE_PORT=5432
DATABASE_NAME=inmonode
DATABASE_USER=postgres
DATABASE_PASSWORD=your-local-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_DAYS=30
# SMTP. Locally, Mailpit (docker compose up inmonode-mail) needs only host and port.
# In production (Brevo): MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587 and the SMTP key as password.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@inmonode.dev
# Web portal page that receives the token from the verification email.
VERIFICATION_URL=http://localhost:5173/verify-email
# Minimum seconds between verification emails to the same address.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Web portal origins allowed by CORS (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Initial staff accounts (prod profile / docker compose), created once on an empty database.
# Hashes are BCrypt; generate one per account with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'the-password' | tr -d ':\n'
# Keep the hashes in single quotes: docker compose would otherwise expand the '$' signs.
# The sample hash is for Dev-Pass-123 and is for local use only; never deploy it.
STAFF_FIELD_AGENT_EMAIL=agent@inmonode.dev
STAFF_FIELD_AGENT_PASSWORD_HASH='$2a$10$W3XWJYgEYadhWhMjUeV15ecZGEw9nc4xWYtqm.0LdXUb4Ld6khxmu'
STAFF_CATALOG_ADMIN_EMAIL=catalog@inmonode.dev
STAFF_CATALOG_ADMIN_PASSWORD_HASH='$2a$10$W3XWJYgEYadhWhMjUeV15ecZGEw9nc4xWYtqm.0LdXUb4Ld6khxmu'
STAFF_FINANCE_ADMIN_EMAIL=finance@inmonode.dev
STAFF_FINANCE_ADMIN_PASSWORD_HASH='$2a$10$W3XWJYgEYadhWhMjUeV15ecZGEw9nc4xWYtqm.0LdXUb4Ld6khxmu'
